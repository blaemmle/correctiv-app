# The built site. CI builds it; nothing here is committed.
dist/

# Extracted by `npm run api` from packages/app-core and apps/mobile/src/components,
# which the build runs first. Not committed: it is 238 KB of derived JSON, and
# regenerating it is one command rather than a merge conflict on every rename in
# either.
content/api.generated.json

# The measurement scratch (`scripts/measure-direct.mjs`): one throwaway entry and
# one build output per component, removed when the run ends and worth nothing if a
# run is interrupted.
.measure/
